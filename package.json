{
  "name": "simplex-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Monitoring dashboard for SimpleX SMP/XFTP servers: IPv4/IPv6/Tor probes, uptime, Prometheus stats, restarts",
  "author": "Tadeas Kmenta",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3334",
    "build": "next build",
    "start": "next start -p 3334",
    "prober": "tsx prober/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "jose": "6.2.8",
    "next": "16.3.1",
    "nodemailer": "9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
