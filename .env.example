# --- Storage ---
# SQLite database file (created automatically). Prober and web share this file (WAL mode).
DATABASE_PATH=./data/monitor.db

# --- Auth (email OTP) ---
# Comma-separated list of emails allowed to log in. Nobody else can request a code.
ALLOWED_EMAILS=tadeas@runonflux.io
# Secret for signing session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
# Session lifetime in days
SESSION_DAYS=7

# --- SMTP (OTP codes + alert emails) --- OPTIONAL ---
# Leave SMTP_* unset to run without email entirely: no alerts are sent, and
# login codes are minted on the server instead of emailed:
#   cd /opt/simplex-monitor/app && sudo -u simplexmonitor yarn issue-code you@example.com
# then use "I already have a code" on the login page.
# Gmail/Google Workspace: enable 2FA, then create an app password at
# https://myaccount.google.com/apppasswords (ports: 465 -> SMTP_SECURE=true,
# 587 -> SMTP_SECURE=false / STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=monitor@example.com
SMTP_PASS=change-me-app-password
SMTP_FROM=monitor@example.com
# Comma-separated recipients for downtime / cert-expiry alerts
ALERT_EMAILS=tadeas@runonflux.io

# --- Prober ---
# Path to the simplex-chat CLI binary
SIMPLEX_CHAT_BIN=/usr/local/bin/simplex-chat
# Directory holding the prober's simplex-chat profile databases (one per transport)
PROBE_DB_DIR=./data/probe-profiles
# Seconds between probe cycles
PROBE_INTERVAL=180
# Seconds before a single check is considered failed. XFTP tests upload a real
# file chunk, which over a slow Tor circuit can take tens of seconds.
PROBE_TIMEOUT=60
# Consecutive failures before an incident opens + alert email is sent
PROBE_FAIL_THRESHOLD=2
# Tor SOCKS proxy for .onion checks
TOR_SOCKS=127.0.0.1:9050
# Days of probe history to keep
PROBE_RETENTION_DAYS=90
# Alert when a TLS certificate expires in fewer than this many days
CERT_WARN_DAYS=14
# Set to false if the VPS has no IPv6 connectivity (v6 checks will be skipped, not failed)
PROBE_IPV6=true

# --- Prometheus (optional; charts hide gracefully when unset) ---
PROMETHEUS_URL=http://127.0.0.1:9090

# --- SSH control (restarts / journal tail) ---
# Private key used to reach the restricted smmonitor user on each VM
SSH_KEY_PATH=/opt/simplex-monitor/keys/smmonitor_ed25519
# Seconds before an SSH command is killed
SSH_TIMEOUT=20
