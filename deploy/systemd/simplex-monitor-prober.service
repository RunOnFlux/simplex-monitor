[Unit]
Description=SimpleX Monitor prober (IPv4/IPv6/Tor checks)
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
User=simplexmonitor
Group=simplexmonitor
WorkingDirectory=/opt/simplex-monitor/app
EnvironmentFile=/opt/simplex-monitor/app/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/yarn prober
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/simplex-monitor/app/data

[Install]
WantedBy=multi-user.target
